{
  "name": "forge-noise",
  "version": "1.1.1",
  "description": "A high-performance noise generation library",
  "scripts": {
    "test": "mocha",
    "build": "terser ForgeNoise.js -c -m -o dist/ForgeNoise.min.js",
    "build:web": "node scripts/generate-api-data.js && node scripts/make-web-data.js && node scripts/copy-dist.js",
    "bench": "node bench/runner.js",
    "bench:quick": "TRIALS=3 node bench/runner.js",
    "release:web": "npm run build && npm run build:web"
  },
  "main": "dist/ForgeNoise.min.js",
  "files": [
    "dist/"
  ],
  "keywords": [
    "noise",
    "perlin",
    "procedural",
    "generation"
  ],
  "author": "cmdaeo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmdaeo/ForgeNoise.git"
  },
  "bugs": {
    "url": "https://github.com/cmdaeo/ForgeNoise/issues"
  },
  "homepage": "https://github.com/cmdaeo/ForgeNoise#readme",
  "overrides": {
    "serialize-javascript": "^7.1.2",
    "diff": "^8.0.3",
    "glob": "^14.0.2",
    "minimatch": "^11.0.0"
  },
  "devDependencies": {
    "fastnoise-lite": "^1.1.1",
    "mocha": "^11.1.0",
    "noisejs": "^2.1.0",
    "open-simplex-noise": "^3.0.0",
    "simplex-noise": "^4.0.3",
    "terser": "^5.51.2"
  }
}
